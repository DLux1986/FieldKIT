ATTENDEE;CN="Conroy, Mike <conroymj@pellapnw.com>";RSVP=TRUE:mailto:conroym
	j@pellapnw.com
ATTENDEE;CN="Nick Duval <NickCDuval@gmail.com>";RSVP=TRUE:mailto:NickCDuval
	@gmail.com
