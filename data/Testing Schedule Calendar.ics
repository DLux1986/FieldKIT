ATTENDEE;CN="Torin Garner";RSVP=TRUE:mailto:Torin@bee-engineers.com
ATTENDEE;CN="Tiffany Knox";ROLE=OPT-PARTICIPANT;RSVP=TRUE:mailto:tknox@pivo
