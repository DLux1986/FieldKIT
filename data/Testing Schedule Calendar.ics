	="1" />\n</o:shapelayout></xml><![endif]--></head><body lang=EN-US link="#
	0563C1" vlink="#954F72" style='word-wrap:break-word'><div class=WordSectio
	n1><div><p class=MsoNormal><span style='font-size:10.5pt'>Robbie &amp\; To
	rin w/ BEE 425-344-6997 <o:p></o:p></span></p><p class=MsoNormal><span sty
	le='font-size:10.5pt'><o:p>&nbsp\;</o:p></span></p><p class=MsoNormal><b><
	u><span style='font-size:10.5pt\;color:red'>Orientation at 7:15 at Job Off
	ice located at 8151 164<sup>th</sup> Ave NE Redmond WA<o:p></o:p></span></
	u></b></p><p class=MsoNormal><span style='font-size:10.5pt'><o:p>&nbsp\;</
	o:p></span></p><p class=MsoNormal><span style='font-size:10.5pt'>Equipment
	 has to be dropped off at the loading zone and <b>parking will be at the o
	ffice off-site</b></span><b><o:p></o:p></b></p><p class=MsoNormal><span st
	yle='font-size:10.5pt'>&nbsp\;</span><o:p></o:p></p><p class=MsoNormal><sp
	an style='font-size:10.5pt'>Scope: As many windows as you can do in 8 hour
	s onsite including the below windows. If it appears a selected location is
	 not ready confer with Denin.</span><o:p></o:p></p><p class=MsoNormal><spa
	n style='font-size:10.5pt'><o:p>&nbsp\;</o:p></span></p><p class=MsoNormal
	><span style='font-size:10.5pt'>5 window products:</span><o:p></o:p></p><u
	l style='margin-top:0in' type=disc><li class=MsoListParagraph style='margi
	n-left:0in\;mso-list:l2 level1 lfo3'><span style='font-size:10.5pt'>Slidin
	g glass door</span><o:p></o:p></li><li class=MsoListParagraph style='margi
	n-left:0in\;mso-list:l2 level1 lfo3'><span style='font-size:10.5pt'>Pictur
	e window</span><o:p></o:p></li><li class=MsoListParagraph style='margin-le
	ft:0in\;mso-list:l2 level1 lfo3'><span style='font-size:10.5pt'>3 casement
	 configurations</span><o:p></o:p></li><li class=MsoListParagraph style='ma
	rgin-left:0in\;mso-list:l2 level1 lfo3'><span style='font-size:10.5pt'>BEE
	 will be test ready @ 10am</span><o:p></o:p></li></ul><p class=MsoListPara
	graph><span style='font-size:10.5pt'>&nbsp\;</span><o:p></o:p></p><p class
	=MsoNormal><span style='font-size:10.5pt'>Windows are in units - 214\, 219
	\, 314. </span><o:p></o:p></p><ul style='margin-top:0in' type=disc><li cla
	ss=MsoListParagraph style='margin-left:0in\;mso-list:l0 level1 lfo6'><span
	 style='font-size:10.5pt'>The head flashing needs to be installed above th
	e sliding glass door.</span><o:p></o:p></li><li class=MsoListParagraph sty
	le='margin-left:0in\;mso-list:l0 level1 lfo6'><span style='font-size:10.5p
	t'>The interior air barrier sealant needs to be in place around all test l
	ocations. </span><o:p></o:p></li><li class=MsoListParagraph style='margin-
	left:0in\;mso-list:l0 level1 lfo6'><span style='font-size:10.5pt'>The GC w
	ill invite the window representative. </span><o:p></o:p></li><li class=Mso
	ListParagraph style='margin-left:0in\;mso-list:l0 level1 lfo6'><span style
	='font-size:10.5pt'>The window test protocol is attached.</span><o:p></o:p
	></li></ul><p class=MsoListParagraph><span style='font-size:10.5pt'>&nbsp\
	;</span><o:p></o:p></p><p class=MsoNormal><span style='font-size:10.5pt'>O
	n site contact: </span><o:p></o:p></p><p class=MsoNormal><b><span style='f
	ont-size:10.0pt\;font-family:"Helvetica"\,sans-serif\;color:#1E3E71'>MARK 
	CARTON</span></b><o:p></o:p></p><p class=MsoNormal><span style='font-size:
	9.0pt\;font-family:"Helvetica"\,sans-serif\;color:#1E3E71'>Project Superin
	tendent</span><o:p></o:p></p><p class=MsoNormal><span style='font-size:9.0
	pt\;font-family:"Helvetica"\,sans-serif\;color:#1E3E71'>e: </span><span st
	yle='font-size:9.0pt\;font-family:"Helvetica"\,sans-serif'><a href="mailto
	:mcarton@therushcompanies.com"><span style='color:blue'>mcarton@therushcom
	panies.com</span></a></span><o:p></o:p></p><p class=MsoNormal style='margi
	n-right:1.0pt\;text-autospace:none'><span style='font-size:9.0pt\;font-fam
	ily:"Helvetica"\,sans-serif\;color:#1E3E71'>o: (253) 858-3636 / <b>c: (206
	) 465-3421</b></span><o:p></o:p></p><p class=MsoNormal style='margin-right
	:1.0pt\;text-autospace:none'><span style='font-size:9.0pt\;font-family:"He
	lvetica"\,sans-serif\;color:#1E3E71'>&nbsp\;</span><o:p></o:p></p><p class
	=MsoNormal><span style='font-size:10.5pt'>&nbsp\;</span><o:p></o:p></p><p 
	class=MsoNormal><o:p>&nbsp\;</o:p></p></div></div></body></html>
